<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.1" 
             xmlns="https://jakarta.ee/xml/ns/persistence" 
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd">
    
    <persistence-unit name="autosalonePU" transaction-type="JTA">
        <jta-data-source>java:app/env/jdbc/AutosaloneDS</jta-data-source>

        <class>com.autosalone.models.User</class>
        <class>com.autosalone.models.Owner</class>
        <class>com.autosalone.models.Customer</class>
        <class>com.autosalone.models.Deadline</class>
        <class>com.autosalone.models.Transaction</class>
        <class>com.autosalone.models.Vehicle</class>
        <class>com.autosalone.models.SalesDocument</class>
        <class>com.autosalone.models.Quotation</class>
        <class>com.autosalone.models.Contract</class>
        <class>com.autosalone.models.CustomerSnapshot</class>
        <class>com.autosalone.models.catalog.AppliedItem</class>
        <class>com.autosalone.models.catalog.PurchasableItem</class>
        <class>com.autosalone.models.catalog.Accessory</class>
        <class>com.autosalone.models.catalog.AccessoryPackage</class>
        <class>com.autosalone.models.catalog.AuditableEntity</class>

        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="update"/>
            
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>